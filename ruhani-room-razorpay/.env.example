# Copy this file to .env and fill in your Razorpay TEST keys first.
# Dashboard → Account & Settings → API Keys (make sure "Test Mode" is switched on).
# .env is git-ignored; never commit it. The secret must only ever live on the server.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional locally; needed on Vercel for the webhook safety net (see PAYMENTS.md).
RAZORPAY_WEBHOOK_SECRET=
